    "1": {
      "label": "AI Tailwind",
      "description": "Role created or expanded by AI. Demand growing."
    },
    "2": {
      "label": "AI-Augmented",
      "description": "Human + AI beats either alone. Lazy practitioners lose."
    },
    "3": {
      "label": "Partially Displaced",
      "description": "Entry tasks automated; senior roles safer. Harder to break in."
    },
    "4": {
      "label": "Heavily Disrupted",
      "description": "Most roles automated in 2\u20134 years."
    },
    "5": {
